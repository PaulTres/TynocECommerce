#Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# MULTI-REGION (optional, overrides the two above): comma-separated, same order.
# UPSTASH_REDIS_REST_URLS=https://eu-xxx.upstash.io,https://us-yyy.upstash.io
# UPSTASH_REDIS_REST_TOKENS=tokenEU,tokenUS

#Neon
# Neon Data API endpoint for this branch/database
NEON_DATA_API_URL=https://ENDPOINT.apirest.REGION.aws.neon.tech/DBNAME/rest/v1
# Owner connection, used only by Prisma CLI migrations and the seed script.
DIRECT_URL=postgresql://OWNER:PASSWORD@HOST/DBNAME?sslmode=require
#Neon Auth
# Neon Managed Auth URL for this Neon branch
NEON_AUTH_BASE_URL=https://ep-BRANCH.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-secret-of-at-least-32-characters