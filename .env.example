# Neon Data API endpoint for this branch/database (copy from Neon Console).
NEON_DATA_API_URL=https://YOUR_ENDPOINT.apirest.REGION.aws.neon.tech/DBNAME/rest/v1

# Owner connection, used only by Prisma CLI migrations and the seed script.
# Do not configure this in the deployed application.
DIRECT_URL=postgresql://OWNER:PASSWORD@HOST/DBNAME?sslmode=require

# Neon Managed Auth URL for this Neon branch (from the Neon Console).
NEON_AUTH_BASE_URL=https://ep-YOUR_BRANCH.neonauth.REGION.aws.neon.tech/neondb/auth
# Random 32+ character secret used to sign the server-side session data cookie.
NEON_AUTH_COOKIE_SECRET=

#Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# MULTI-REGION (optional, overrides the two above): comma-separated, same order.
# UPSTASH_REDIS_REST_URLS=https://eu-xxx.upstash.io,https://us-yyy.upstash.io
# UPSTASH_REDIS_REST_TOKENS=tokenEU,tokenUS
