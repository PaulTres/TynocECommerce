# Neon PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

#Auth.js
# Generate with npx auth secret
AUTH_SECRET=
# Required only when not deployed on Vercel (Vercel sets the host automatically).
AUTH_URL=http://localhost:3000

#Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# MULTI-REGION (optional, overrides the two above): comma-separated, same order.
# UPSTASH_REDIS_REST_URLS=https://eu-xxx.upstash.io,https://us-yyy.upstash.io
# UPSTASH_REDIS_REST_TOKENS=tokenEU,tokenUS
