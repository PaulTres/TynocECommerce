#AWS
#Vercel reserves the AWS_* names, so we use the APP_AWS_* prefix.
AWS_PROFILE=parcel-store-dev
APP_AWS_REGION=eu-central-1
APP_AWS_ACCESS_KEY_ID=
APP_AWS_SECRET_ACCESS_KEY=
DYNAMODB_TABLE_NAME=parcel-store
GSI1=GSI1
GSI2=GSI2
# Only needed with local database.
DYNAMODB_ENDPOINT=http://localhost:8000

#Auth.js
# Generate with npx auth secret
AUTH_SECRET=
# Required only when not deployed on Vercel (Vercel sets the host automatically).
AUTH_URL=http://localhost:3000
