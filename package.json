{
    "name": "parcel-store",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "test": "vitest",
        "db:push": "dotenv -e .env.local -- prisma db push",
        "db:rls": "dotenv -e .env.local -- prisma db execute --file prisma/rls.sql --schema prisma/schema.prisma",
        "db:app-user": "dotenv -e .env.local -- prisma db execute --file prisma/app-user-mapping.sql --schema prisma/schema.prisma",
        "db:seed": "tsx --env-file=.env.local scripts/seed.ts"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@neon/auth": "^0.8.2",
        "@neondatabase/auth": "0.7.0-beta",
        "@neondatabase/neon-js": "0.9.0-beta",
        "@prisma/client": "^6.16.2",
        "@upstash/ratelimit": "^2.2.0",
        "@upstash/redis": "^1.40.0",
        "better-auth": "~1.7.15",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cn": "^0.5.2",
        "lucide-react": "^1.66.0",
        "next": "^16.4.3",
        "next-auth": "^5.0.0-beta.25",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "shadcn": "^4.23.0",
        "tw-animate-css": "^1.4.0",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@eslint/css": "^2.0.0",
        "@eslint/js": "^9.39.0",
        "@eslint/json": "^2.1.1",
        "@eslint/markdown": "^8.0.3",
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^22.10.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^6.1.2",
        "autoprefixer": "^10.4.20",
        "dotenv-cli": "^8.0.0",
        "eslint": "^9.39.0",
        "eslint-config-next": "^16.4.2",
        "globals": "^17.13.0",
        "jsdom": "^30.1.3",
        "postcss": "^8.4.49",
        "prisma": "^6.16.2",
        "tailwind-csstree": "^0.4.1",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.0.0",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^2.1.8"
    }
}
